+bool PatchManager::TryPatchNSOInPlace(std::span<u8> body, const BuildID& build_id_raw,
+                                    const std::string& name) const {
+    if (Settings::values.dump_nso)
+        return false;
+    const auto load_dir = GetModificationLoadRoot();
+    if (load_dir == nullptr)
+        return false;
+    const auto build_id = Common::HexToString(build_id_raw);
+    auto patch_dirs = load_dir->GetSubdirectories();
+    std::sort(patch_dirs.begin(), patch_dirs.end(),
+              [](const VirtualDir& l, const VirtualDir& r) { return l->GetName() < r->GetName(); });
+    const auto patch_files = CollectPatches(patch_dirs, build_id);
+    // Preflight the complete list so mixed IPS/text collections fall back
+    // without partially applying anything or changing their ordering.
+    for (const auto& file : patch_files) {
+        if (file->GetExtension() != "pchtxt")
+            return false;
+    }
+    std::vector<std::unique_ptr<IPSwitchCompiler>> compiled;
+    compiled.reserve(patch_files.size());
+    for (const auto& file : patch_files)
+        compiled.push_back(std::make_unique<IPSwitchCompiler>(file));
+    for (const auto& compiler : compiled)
+        compiler->ApplyToModule(body, sizeof(Loader::NSOHeader));
+    LOG_INFO(Loader, "Patched module {} in place: {} text patches, {} bytes; no image copies",
+             name, compiled.size(), body.size());
+    return true;
+}
