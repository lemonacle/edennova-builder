+void IPSwitchCompiler::ApplyToModule(std::span<u8> body, std::size_t header_size) const {
+    for (const auto& patch : patches) {
+        if (!patch.enabled)
+            continue;
+        for (const auto& record : patch.records) {
+            ApplyModulePatchWrite(body, header_size, record.first, record.second.data);
+        }
+    }
+}
+
 } // namespace FileSys
