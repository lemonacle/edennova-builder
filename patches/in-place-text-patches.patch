diff --git a/src/core/file_sys/module_patch_write.h b/src/core/file_sys/module_patch_write.h
new file mode 100644
index 0000000..178643b
--- /dev/null
+++ b/src/core/file_sys/module_patch_write.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <span>
+
+namespace FileSys {
+// Reproduce a write to [synthetic header | body], followed by restoration
+// of the header, without allocating or copying that combined image.
+inline void ApplyModulePatchWrite(std::span<std::uint8_t> body,
+                                  std::size_t header_size, std::size_t offset,
+                                  std::span<const std::uint8_t> bytes) {
+    if (offset < header_size) {
+        const auto skip = std::min(header_size - offset, bytes.size());
+        bytes = bytes.subspan(skip);
+        offset += skip;
+        if (offset < header_size)
+            return;
+    }
+    const auto destination = offset - header_size;
+    if (destination >= body.size() || bytes.empty())
+        return;
+    const auto count = std::min(bytes.size(), body.size() - destination);
+    std::memcpy(body.data() + destination, bytes.data(), count);
+}
+} // namespace FileSys
